{
  "name": "keylogger.js",
  "version": "0.0.0-development",
  "description": "Global keyboard listener for push-to-talk and hotkeys on macOS, Windows, and Linux",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "gypfile": true,
  "files": [
    "src/**/*",
    "binding.gyp",
    "prebuilds/**/*"
  ],
  "scripts": {
    "install": "node-gyp-build",
    "prebuild": "prebuildify --napi --strip",
    "test": "node --test \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@semantic-release/exec": "^7.1.0",
    "clang-format": "^1.8.0",
    "prebuildify": "^6.0.1",
    "semantic-release": "^24.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aabuhijleh/keylogger.js.git"
  },
  "keywords": [
    "keyboard",
    "global",
    "listener",
    "push-to-talk",
    "hotkey",
    "native"
  ],
  "author": {
    "name": "Abed Abu-Hijleh",
    "email": "aabuhijleh.dev@gmail.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/aabuhijleh/keylogger.js/issues"
  },
  "homepage": "https://github.com/aabuhijleh/keylogger.js#readme"
}
